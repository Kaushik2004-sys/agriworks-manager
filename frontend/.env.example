# Frontend environment - copy to .env
# Local development: point at the local Django backend.
# PRODUCTION: set VITE_API_URL in the hosting build environment to the
# public backend URL, e.g. https://your-backend.example/api
# A production build without VITE_API_URL fails at startup by design
# (it will never silently call localhost).
VITE_API_URL=http://127.0.0.1:8000/api
# Google Login (Phase 3, optional): OAuth/Web Client ID from Google Cloud
# Console. Shown to the browser by design (public identifier, no secret).
# When unset, Google buttons stay hidden and password login keeps working.
# VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
