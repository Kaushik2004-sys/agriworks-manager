# Frontend environment - copy to .env
# Local development: point at the local Django backend.
# PRODUCTION: set VITE_API_URL in the hosting build environment to the
# public backend URL, e.g. https://your-backend.example/api
# A production build without VITE_API_URL fails at startup by design
# (it will never silently call localhost).
VITE_API_URL=http://127.0.0.1:8000/api
