# Copy this file to .env and fill real values. Never commit .env with passwords.
DJANGO_SECRET_KEY=django-insecure-dev-only-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database: MySQL (agriworks_db) is the only supported database.
DB_NAME=agriworks_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Allow React frontend origin
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend URL used by the app
FRONTEND_URL=http://localhost:5173

# Email (password reset). In DEBUG the console backend is used by default,
# so no SMTP setup is needed for local testing.
# For production (real reset emails), set:
# EMAIL_BACKEND=smtp
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@example.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=AgriWorks <you@example.com>

# Password reset emails use the EMAIL_* variables above. No SMS
# configuration is required: password reset is email-based.

# ---- Production deployment (P6) ----
# Copy these into the hosting environment (never into Git). With
# DJANGO_DEBUG unset/False, Django fails loudly at boot unless every
# required production value below is configured - nothing silently
# falls back to insecure development defaults.
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<generate one: python -c "import secrets; print(secrets.token_urlsafe(50))">
# DJANGO_ALLOWED_HOSTS=your-backend.example
# CORS_ALLOWED_ORIGINS=https://your-frontend.example
# CSRF_TRUSTED_ORIGINS=https://your-frontend.example
# FRONTEND_URL=https://your-frontend.example
# Optional HTTPS tuning (defaults are the secure ones):
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
